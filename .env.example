# Neon / Vercel Postgres connection string (leave empty locally to use an in-memory store)
DATABASE_URL=

# Password for the builder dashboard at /admin (required on Vercel; defaults to "admin" locally)
ADMIN_PASSWORD=
# Optional: separate secret for signing admin sessions
SESSION_SECRET=

# Builder contact shown on the customer site (digits with country code, e.g. 919876543210)
VITE_BUILDER_PHONE=
VITE_BUILDER_WHATSAPP=

# RERA registration number of the project (shown on WhatsApp stock updates and generated creatives)
VITE_RERA_ID=

# Anthropic API key for the dashboard assistant (ask your stock, morning note). Optional: without it,
# the dashboard uses simple keyword rules and a fixed template instead.
ANTHROPIC_API_KEY=

# DISPOSABLE, local only: with no API key, AI_DEV_CLI=1 routes AI calls through the installed `claude` CLI.
AI_DEV_CLI=

# Facebook / Instagram lead ads webhook (Meta for Developers → Webhooks → leadgen)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=

# WhatsApp Business Platform (Cloud API)
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_ID=
# Public site URL used in WhatsApp replies (defaults to the Vercel production URL)
SITE_URL=

# Phone alerts for new leads (Web Push). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
